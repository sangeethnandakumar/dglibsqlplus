<?xml version="1.0" encoding="UTF-8"?>
<drivers>
  <driver id="tursoremote" name="Turso Remote" driver-class="com.sangeethnandakumar.libsql.LibSqlDriver" dialect="SQLITE">
    <url-template name="Turso Cloud" template="jdbc:libsql:https://{host}" default="true"/>
    <url-template name="Local" template="jdbc:libsql:{host::localhost}[:{port::8080}]"/>
    <option name="auto-sync" value="true"/>
    <option name="keep-alive" value="SELECT 1"/>
    <library>
      <url>file://$APPLICATION_CONFIG_DIR$/plugins/dglibsqlplus/datagrip-driver-libsql/libsql-driver.jar</url>
    </library>
  </driver>
</drivers>
